# ==============================================================================
# PicoPOSSUM Environment Configuration Template
# ==============================================================================
# PicoPOSSUM is an offline-first desktop application that operates locally
# without external cloud APIs. All configuration defaults are set securely.
#
# To override settings for development or custom deployments, copy this file
# to `.env` and adjust the variables as required:
#   cp .env.example .env
#
# NOTE: Never commit `.env` containing sensitive environment credentials.
# ==============================================================================

# Application Environment (development | production)
NODE_ENV=production

# Tauri development server port (default: 1420)
VITE_DEV_PORT=1420

# Logging level (error | warn | info | debug | trace)
RUST_LOG=warn
